# FFOpt elemental BCC example: two ordered Fe basis labels, three free LJ values.
ffopt 1
project fe_bcc
material elemental Fe
crystal bcc
workflow bo sample audit screen nn al finalists validate

parameters
    range epsilon absolute 0.001 10.0
    range sigma   absolute 0.001 5.0
    # Global LJ protocol inherited by bulk, surface, and both elastic modules.
    # 12.5 A = 2.5 * maximum sigma bound (5 A).
    cutoff 12.5 A
    mixing default

    # Corner/body are an ordered two-sublattice surrogate.  Keep their well
    # depth identical and bound the artificial size contrast.
    tie epsilon all
    difference sigma Fe_corner Fe_body max 0.75 A

    # id  label       epsilon(kcal/mol)  sigma(A)
    # Charge is implicitly disabled for an elemental material.  The initial
    # values are one previously measured same-material point.  ``incumbent
    # initial`` below protects only this coordinate: every structural, static,
    # and dynamic property is recalculated under the current protocol.  New
    # materials should use a physical initial guess and ``incumbent off``.
    type 1 Fe_corner 6.0091765721 2.5804861035
    type 2 Fe_body   6.0091765721 2.0426427897
end

property bulk
    data data/Fe_a_2type_555.data
    cells_in_data 5 5 5
    replicate 2 2 2
    temperature 300 K
    pressure 1 atm
    tdamp 100 fs
    pdamp 1000 fs
    equilibration 20000
    production 40000

    target a        2.8665 A      weight 1.0 tolerance 0.028665
    target b        2.8665 A      weight 1.0 tolerance 0.028665
    target c        2.8665 A      weight 1.0 tolerance 0.028665
    target alpha   90.0000 degree weight 1.0 tolerance 1.0
    target beta    90.0000 degree weight 1.0 tolerance 1.0
    target gamma   90.0000 degree weight 1.0 tolerance 1.0
    target density  7.8740 g/cm3  weight 1.0 tolerance 0.078740
end

property surface
    complete data/Fe_a_2type_555_complete.data
    split    data/Fe_a_2type_555_split.data
    facet 110
    replicate 2 2 1
    target 2.340 J/m2 weight 1.0 tolerance 0.117
end

property elasticity
    # The cubic evaluator still computes C11/C12/Cprime/C44 for Born stability
    # and diagnostics.  Selection follows the user-facing isotropic moduli.
    # Static targets are the Hill properties derived from the internally
    # consistent low-temperature Rayne--Chandrasekhar constants.
    module static objective
    target static B       173.10 GPa
    target static G        86.94 GPa
    target static E       223.40 GPa
    target static nu        0.2848 1

    # Final selection uses the explicitly requested room-temperature bulk,
    # shear, Young, and Poisson targets.  No fixed 0 K -> 300 K scale factor is
    # assumed; three independent trajectories determine the final ranking.
    module dynamic promotion
    target dynamic B       170.00 GPa
    target dynamic G        82.00 GPa
    target dynamic E       211.00 GPa
    target dynamic nu        0.2900 1

    gate lattice 1 percent
    gate angles 1 degree
    gate density 1 percent
    gate surface 5 percent
    born required
    r2 0.98
    static_drift 5 percent
    tier 20 percent

    # Static uses small deterministic strains and extrapolates the symmetric
    # stress response to zero strain.  Dynamic uses larger strains to retain a
    # measurable signal above finite-temperature stress noise.
    static_strain  0.0005 0.001 0.002
    dynamic_strain 0.002  0.004 0.006
    replicate 2 2 2
    temperature 300 K
    timestep 1 fs
    # Adaptive promotion first evaluates 38 dispersed candidates with seed 101,
    # then gives only the exact one-seed Top-10 the remaining seeds 202/303.
    npt_equilibration 20000
    nvt_equilibration 20000
    production 40000
    seeds 101 202 303

    # Independent production-grade holdout for the single promoted winner.
    # This restores the converged legacy trajectory length without applying it
    # to every candidate.
    validation_strain 0.001 0.003
    validation_npt_equilibration 200000
    validation_nvt_equilibration 50000
    validation_production 500000
    validation_seeds 404 505 606
end

bo
    method auto
    objective feasible_coverage
    # Evaluate the known feasible initial point before launching LHS/BO.  Any
    # cutoff/data/protocol drift stops the run after this single calculation.
    warm_start_gate structural
    # The public audit stage below is the sole replicated structural audit.
    # Disable the optimizer's legacy internal audit to avoid duplicate LAMMPS work.
    stability_audit off
    initial_points 76
    batch_size 38
    max_rounds 40
    # In 3 free dimensions, require at least 8 dispersed strict points spanning
    # rank 3, 4 genuinely outside near-boundary anchors, and no surrogate fallback.
    coverage archive 96 pool 16384 feasible 0.50 boundary 0.25 uncertainty 0.15 global 0.10 min_archive 8 min_boundary 4 min_separation 0.001 min_weak_span 0.001 max_fallbacks 0
end

sample
    points 1520
    centers 48
    center_selection diverse
    radii 0.010 0.020 0.050 0.100
    boundary_fraction 0.20
    global_fraction 0.10
    seeds 101
    design_seed 20260809
end

audit
    top_k 160
    seeds 101 202 303
    max_workers 38
end

screen
    minimum 480
    per_dimension 160
    maximum 1200
    core_fraction 0.75
    buffer_multiplier 1.50
    elite_fraction 0.10
end

nn
    method gp
end

al
    acquisition constrained_minimax
    rounds 8
    candidates 76
    static_candidates 38
    candidate_pool 65536
    improvement_fraction 0.55
    boundary_fraction 0.30
    global_fraction 0.15
    early_stop patience 3
    early_stop improvement 0.5
end

finalists
    minimum 10
    maximum 20
    mode adaptive
    triage 38
    confirm 10
    triage_seed 101
    clusters auto
    max_clusters 8
    cluster_minimum 1
    incumbent initial
    window 1.0
    diverse 4
    # Never hide a thin confirmation pool by silently promoting fewer points.
    require_minimum yes
end

validate
    require_tolerances yes
end
