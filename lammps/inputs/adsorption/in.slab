# in.slab -- adsorption box 2/3 : Au slab only, UNCHARGED   (0 K ENERGY MINIMIZATION)
# Deterministic; pure Au -> plain lj/cut (no coul/long, no kspace).
# Au LJ from data file; pair_coeffs.lmp only sets the mixing rule.
# Prints: DATA_AD: <pe_min>
units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff
special_bonds   lj/coul 0.0 0.0 1.0

pair_style      lj/cut ${cutoff}
read_data       ${data}
include         pair_coeffs.lmp
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

thermo          50
thermo_style    custom step pe evdwl fmax
min_style       cg
if "${save_traj} == 1" then &
  "dump TRAJ all custom 10 ad_slab_min_trajectory.lammpstrj id type x y z"
if "${save_traj} == 1" then "dump_modify TRAJ sort id"
minimize        1.0e-8 1.0e-10 100000 1000000

print           "DATA_AD: $(pe)"
if "${save_traj} == 1" then "undump TRAJ"
if "${save_traj} == 1" then "write_data ad_slab_min.lammps nocoeff"
