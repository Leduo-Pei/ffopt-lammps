# ============================================================================
# in.bulk.mol -- v8  (MOLECULAR CRYSTAL variant)
#
# Bulk NPT 300 K for MOLECULAR crystals with a full Class-I (CVFF) force field:
#   bonded terms  : bond/angle/dihedral/improper read from the data file
#   nonbonded     : pair_style lj/cut/coul/long + kspace ewald
#
# Difference vs in.bulk.charged
# -----------------------------
#   * Declares bond_style / angle_style / dihedral_style / improper_style
#     BEFORE read_data, so the "* Coeffs" sections in the data file parse.
#   * Sets special_bonds (CVFF: exclude 1-2,1-3; include 1-4 at full strength).
#   * NO 'change_box all triclinic': the data box already carries xy/xz/yz
#     tilt factors, so it is already triclinic and change_box would error.
#   * Per-atom charges come from 'set type N charge Q' (pair_coeffs.lmp),
#     which OVERRIDES the data-file charges -> lets BO optimise charges.
#
# When to use this script
# -----------------------
#   config.yaml:
#     charge.enabled: true            # charges are optimised
#     lammps.bulk_input: "in.bulk.mol"
#
# Variables passed via -var (set by lammps_interface.py):
#   bulk_data        : path to LAMMPS data file (atom_style full)
#   nx, ny, nz       : number of primitive cells already contained in the data
#                      file (used only to normalise reported a/b/c; NO replicate)
#   timestep_value   : MD timestep [fs]
#   cutoff           : LJ + Coulomb real-space cutoff [Å]
#   kspace_accuracy  : Ewald reciprocal-space accuracy (e.g. 1.0e-5)
#   npt_seed         : velocity initialization seed
#   equil_steps      : NPT equilibration run length [steps] (discarded)
#   prod_steps       : NPT production run length [steps] (time-averaged)
#   save_traj        : 0 = skip trajectory  |  1 = write trajectory + structure
#
# Included file (auto-generated by lammps_interface._build_pair_coeffs):
#   pair_coeffs.lmp : pair_modify mix geometric
#                     pair_coeff i i epsilon sigma   (per atom type)
#                     set type N charge Q            (per atom type)
#
# Output line (parsed by lammps_interface._parse_data_line):
#   DATA_BULK: a_0K a b c alpha beta gamma_ang density pe enthalpy
#   Column order MUST match config.yaml output_mapping.bulk.columns exactly.
# ============================================================================

units           real
dimension       3
boundary        p p p
atom_style      full
newton          on

# Inverse "cells-in-data" factors for per-cell lattice parameter reporting.
# (The data file already IS the supercell; nothing is replicated here.)
variable inv_nx equal 1.0/${nx}
variable inv_ny equal 1.0/${ny}
variable inv_nz equal 1.0/${nz}

# ----------------------------------------------------------------------------
# Bonded interaction styles -- MUST be set before read_data so the
# "Bond/Angle/Dihedral/Improper Coeffs" sections in the data file are parsed.
# Styles taken from the data-file headers (msi2lmp / CGCMM, CVFF):
#   Bond Coeffs # harmonic      -> bond_style harmonic
#   Angle Coeffs # harmonic     -> angle_style harmonic
#   Dihedral Coeffs # harmonic  -> dihedral_style harmonic
#   Improper Coeffs # cvff      -> improper_style cvff
# ----------------------------------------------------------------------------
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff

# CVFF 1-4 convention (@combination geometric, class I):
#   exclude 1-2 and 1-3 nonbonded; include 1-4 LJ + Coulomb at full strength.
special_bonds   lj/coul 0.0 0.0 1.0

# LJ + long-range Coulomb pair style (CVFF nonbond 12-6 + partial charges).
# pair_style coul/long may be declared before kspace_style; kspace just has to
# exist before the first run.
pair_style      lj/cut/coul/long ${cutoff}

read_data       ${bulk_data}

# pair_coeffs.lmp (auto-generated) contains:
#   pair_modify mix geometric
#   pair_coeff i i epsilon_i sigma_i   (one line per atom type)
#   set type N charge Q                (one line per atom type; overrides data)
include         pair_coeffs.lmp

# kspace_style is defined AFTER read_data: the data box is already triclinic
# (has xy/xz/yz tilt), and pppm errors with "Must redefine kspace_style after
# changing to triclinic box" if declared while/before the box becomes triclinic.
# Declaring it here (box already triclinic) is the documented fix.
# Switch to 'ewald ${kspace_accuracy}' if pppm grid setup ever complains.
kspace_style    pppm ${kspace_accuracy}

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ----------------------------------------------------------------------------
# Stage 1: 0 K conjugate-gradient minimize (box shape fixed)
# ----------------------------------------------------------------------------
minimize        1.0e-8 1.0e-10 100000 1000000
run             0

variable a_0K equal $(cella*v_inv_nx)

# ----------------------------------------------------------------------------
# Stage 2: NPT 300 K, fully flexible (tri) box.
#   temp  damping : 100 fs
#   press damping : 1000 fs
# Molecular crystal held together by vdW + electrostatics; tri lets all 6 box
# DOF relax so a wrong force field is exposed rather than hidden.
# ----------------------------------------------------------------------------
velocity        all create ${temperature} ${npt_seed} mom yes rot yes dist gaussian
fix NPT all npt temp ${temperature} ${temperature} 100.0 tri ${pressure} ${pressure} 1000.0
timestep        ${timestep_value}

thermo          5000
thermo_style    custom step temp press pe enthalpy vol density

# Equilibration (discarded)
run             ${equil_steps}

reset_timestep  0

# Trajectory dump (only when save_traj=1)
if "${save_traj} == 1" then &
  "dump TRAJ all custom 100 npt_trajectory.lammpstrj id type q x y z vx vy vz"

# ----------------------------------------------------------------------------
# Time-averaged lattice + density + bulk thermodynamics over production run
#   fix ave/time: Nevery=5, Nrepeat=1000, Nfreq=5000
# ----------------------------------------------------------------------------
variable a_inst   equal cella*v_inv_nx
variable b_inst   equal cellb*v_inv_ny
variable c_inst   equal cellc*v_inv_nz
variable al_inst  equal cellalpha
variable bt_inst  equal cellbeta
variable gm_inst  equal cellgamma
variable d_inst   equal density
variable pe_inst  equal pe
variable h_inst   equal enthalpy

fix AVE all ave/time 5 1000 5000 &
    v_a_inst v_b_inst v_c_inst    &
    v_al_inst v_bt_inst v_gm_inst &
    v_d_inst v_pe_inst v_h_inst

run             ${prod_steps}

# $(...) forces immediate evaluation BEFORE unfix destroys fix AVE
variable a_mean     equal $(f_AVE[1])
variable b_mean     equal $(f_AVE[2])
variable c_mean     equal $(f_AVE[3])
variable al_mean    equal $(f_AVE[4])
variable bt_mean    equal $(f_AVE[5])
variable gm_mean    equal $(f_AVE[6])
variable d_mean     equal $(f_AVE[7])
variable pe_mean    equal $(f_AVE[8])
variable h_mean     equal $(f_AVE[9])

unfix AVE
unfix NPT

# ----------------------------------------------------------------------------
# Output line parsed by lammps_interface._parse_data_line()
#   a_0K  a  b  c  alpha  beta  gamma_ang  density  pe  enthalpy
# ----------------------------------------------------------------------------
print "DATA_BULK: ${a_0K} ${a_mean} ${b_mean} ${c_mean} ${al_mean} ${bt_mean} ${gm_mean} ${d_mean} ${pe_mean} ${h_mean}"

if "${save_traj} == 1" then "undump TRAJ"
if "${save_traj} == 1" then "write_data final_structure.lammps nocoeff"
